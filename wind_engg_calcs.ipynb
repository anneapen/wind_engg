   "source": [
    "def power_law_wind_speed(z:float,zref:float,Vref:float,alpha:float)->float:\n",
    "    \"\"\"\n",
    "    Returns the wind speed based on power law\n",
    "    \"\"\"\n",
    "    Vz=Vref*((z/zref)**alpha)\n",
    "    return round(Vz,2)"
   ]
  },
